1 REM =====================================================
2 REM LOGDRW - APPLE II LOGIC GATE DRAWING / SIMULATOR
3 REM Shape table LOGSYB is loaded at $0300; actual shapes unknown
4 REM === PROGRAM SETUP / MEMORY / SHAPE TABLE LOAD ===
0 LOMEM: 24576
5	SCALE = 1 : ROT = 0
10		DIM G%(15,10), N(15), K(15): POKE 232,0: POKE 233,3
20		PRINT  CHR$ (4): "BLOAD LOGSYB,A$300"
30		GOSUB 1010
40		HOME : VTAB 20: CALL -950
41		HCOLOR = 7
45		VTAB 20
49 REM === MAIN MENU LOOP / OPERATION DISPATCH ===
50		GOSUB1200
60		INPUT "OPERATION? ";A$: IF A$ = "X" THEN GOTO 5000
65		A = VAL (A$): Z = 0
70 	ON A GOTO 100,400,600,700,800,1001
80		GOTO 50
90 REM === START SYMBOL / GATE ENTRY ROUTINE ===
100	VTAB 19: CALL -958
110	VTAB 21: INPUT "ENTER GATE ID # ";ID
115	IF G%(ID,1) = ID THEN PRINT "YOU HAVE USED THAT ID#.": GOTO 110
120 	G%(ID,1) = ID
130	PRINT "ENTER COLUMN OF GATE ID # ";ID: INPUT " ";C1
140	IF C1 > 5 OR C1 < 0 THEN GOTO 130
150	IF C1 = 0 THEN G%(ID,1) = 0: GOTO 100
160	G%(ID,2) = C1 * 50
170	PRINT "ENTER ROW OF GATE ID # ";ID;: INPUT " ";R1
180	IF R1 < 0 OR R1 > 3 THEN GOTO 170
185	GOSUB 1630
187	IF D1 = 1 THEN D1 = 0: PRINT "YOU HAVE USED THAT LOCATION.": GOTO 130
190	G%(ID,3) = R1 * 50 - 15
200 	IF R1 = 0 THEN G%(ID,3) = 0: G%(ID,2) = 0: GOTO 130
210 	PRINT "ENTER TYPE OF GATE # ";ID;: INPUT " ";T1
220 	G%(ID,7) = T1
230	IF T1 = 1 OR T1 = 2 THEN G%(ID,4) = 999:G%(ID,8) = 999: GOTO 260
240	INPUT "ENTER ID# OF TOP INPUT NODE ";TN
250	G%(ID,4) = TN
260	INPUT "ENTER ID# OF BOT OR ONLY INPUT NODE ";BN
